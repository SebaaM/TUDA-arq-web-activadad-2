# Origen de la API usado por el servidor durante el build (SSG).
# El proceso Node consulta esta URL absoluta para generar las paginas.
API_BUILD_URL=http://127.0.0.1:8000/api/v1

# Base que usa la isla interactiva en el navegador.
# Es una ruta relativa: el dev server / preview de Astro la proxifica hacia
# http://127.0.0.1:8000 (ver astro.config.mjs) porque la API no envia
# cabeceras CORS y el backend no puede modificarse.
PUBLIC_API_URL=/api/v1

# Identidad de laboratorio precargada si localStorage todavia no guarda una.
# Debe existir en la base de datos del backend: consultá GET /api/v1/participants/
# o regenerá datos con `python manage.py seed_participants_and_enrollments`.
PUBLIC_PARTICIPANT_ID=a1234567-89ab-cdef-0123-456789abcdef
